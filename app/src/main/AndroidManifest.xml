<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <application
        android:name=".SoSinhVienApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_legacy"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_legacy"
        android:supportsRtl="true"
        android:theme="@style/Theme.SoSinhVien">

        <activity
            android:name=".ui.compose.ComposeActivity"
            android:exported="true"
            android:theme="@style/Theme.SoSinhVien">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.AuthActivity" android:exported="false" />
        <activity android:name=".ui.onboarding.OnboardingActivity" android:exported="false" />
        <activity android:name=".ui.main.MainActivity" android:exported="false" />
        <activity android:name=".ui.finance.AddTransactionActivity" android:exported="false" />
        <activity android:name=".ui.finance.OcrConfirmActivity" android:exported="false" />
        <activity android:name=".ui.finance.BudgetSetupActivity" android:exported="false" />
        <activity android:name=".ui.finance.CategoriesActivity" android:exported="false" />
        <activity android:name=".ui.finance.StatisticsActivity" android:exported="false" />
        <activity android:name=".ui.calendar.AiScheduleActivity" android:exported="false" />
    </application>

</manifest>
