<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/budget_setup"
            style="@style/TextAppearance.SoSinhVien.Headline" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Tháng áp dụng">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Tổng ngân sách (VND)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_total_budget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Số dư đầu kỳ">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_opening_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/text_allocation_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="@color/on_surface_subtle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Phân bổ theo danh mục (demo):"
            style="@style/TextAppearance.SoSinhVien.Title" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ăn uống — 2.000.000 đ" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Di chuyển — 800.000 đ" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Học tập — 1.500.000 đ" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Giải trí — 1.200.000 đ" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Khác — 1.000.000 đ" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.SoSinhVien.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save" />
    </LinearLayout>
</ScrollView>
