<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SoSinhVien" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_container</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorTertiary">@color/tertiary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.SoSinhVien.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.SoSinhVien.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_container</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="TextAppearance.SoSinhVien.Currency" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary_container</item>
    </style>

    <style name="TextAppearance.SoSinhVien.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SoSinhVien.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SoSinhVien.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.SoSinhVien.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/on_surface_subtle</item>
    </style>
</resources>
